# The image the portable linux packages are built in.

FROM docker.io/library/debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl file git pkg-config \
      libwebkit2gtk-4.1-dev libgtk-3-dev libssl-dev librsvg2-dev \
      libayatana-appindicator3-dev libasound2-dev \
      desktop-file-utils patchelf squashfs-tools xz-utils zsync \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --default-toolchain stable --profile minimal \
 && chmod -R a+w "$RUSTUP_HOME" "$CARGO_HOME"
