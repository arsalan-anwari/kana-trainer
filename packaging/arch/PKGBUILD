pkgname=kana-trainer
pkgver=1.7.2
pkgrel=1
pkgdesc="Practice hiragana and katakana with quizzes, typing drills and audio"
arch=('x86_64')
url="https://github.com/arsalan-anwari/kana-trainer"
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  npm install
  npm run build
  cargo build --release --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 "src-tauri/target/release/kana-trainer" "$pkgdir/usr/bin/kana-trainer"
  install -Dm644 "packaging/linux/nl.anwari.kanatrainer.desktop" "$pkgdir/usr/share/applications/nl.anwari.kanatrainer.desktop"
  install -Dm644 "packaging/linux/nl.anwari.kanatrainer.metainfo.xml" "$pkgdir/usr/share/metainfo/nl.anwari.kanatrainer.metainfo.xml"
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/nl.anwari.kanatrainer.png"
  install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/nl.anwari.kanatrainer.png"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
